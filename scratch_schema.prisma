generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EdxAuditLog {
  edxAuditId         String      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_audit_id") @db.Uuid
  edxAuditUserId     String?     @map("edx_user_id") @db.Uuid
  edxAuditUserName   String?     @map("edx_audit_user") @db.VarChar(100)
  edxAuditModule     String      @map("edx_audit_module") @db.VarChar(50)
  edxAuditPayload    Json?       @map("edx_audit_payload")
  edxAuditIp         String?     @map("edx_audit_ip") @db.VarChar(45)
  edxAuditMethod     String?     @map("edx_audit_method") @db.VarChar(10)
  edxAuditUrl        String?     @map("edx_audit_url")
  edxAuditStatusCode Int?        @map("edx_audit_status_code")
  edxAuditCreatedAt  DateTime?   @default(now()) @map("edx_audit_created_at") @db.Timestamp(6)

  @@map("edx_audit_logs")
}

model EdxBanner {
  edxBanId          String      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_ban_id") @db.Uuid
  edxBanTitle       String?     @map("edx_ban_title") @db.VarChar(200)
  edxBanDescription String?     @map("edx_ban_description")
  edxBanImage       String?     @map("edx_ban_image")
  edxBanFilm        String?     @map("edx_ban_film")
  edxBanIframe      String?     @map("edx_ban_iframe")
  edxBanStatus      Int?        @default(1) @map("edx_ban_status")
  edxBanCreatedAt   DateTime?   @default(now()) @map("edx_ban_created_at") @db.Timestamp(6)
  edxBanUpdatedAt   DateTime?   @default(now()) @map("edx_ban_updated_at") @db.Timestamp(6)
  edxBanDuration    Int?        @default(0) @map("edx_ban_duration")

  @@map("edx_banners")
}

model EdxPopup {
  edxPopId          String      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_pop_id") @db.Uuid
  edxPopTitle       String?     @map("edx_pop_title") @db.VarChar(200)
  edxPopDescription String?     @map("edx_pop_description")
  edxPopImage       String?     @map("edx_pop_image")
  edxPopFilm        String?     @map("edx_pop_film")
  edxPopIframe      String?     @map("edx_pop_iframe")
  edxPopUrl         String?     @map("edx_pop_url")
  edxPopStatus      Int?        @default(1) @map("edx_pop_status")
  edxPopCreatedAt   DateTime?   @default(now()) @map("edx_pop_created_at") @db.Timestamp(6)
  edxPopUpdatedAt   DateTime?   @default(now()) @map("edx_pop_updated_at") @db.Timestamp(6)
  edxPopDuration    Int?        @default(0) @map("edx_pop_duration")
  edxPopKey         String?     @map("edx_pop_key") @db.VarChar(50)
  edxPopTargetPage  String?     @default("dashboard") @map("edx_pop_target_page") @db.VarChar(50)

  @@map("edx_popups")
}



model EdxUser {
  edxUserId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("edx_user_id") @db.Uuid
  edxUserEmail      String    @unique @map("edx_user_email") @db.VarChar(150)
  edxUserPassword   String    @map("edx_user_password")
  edxUserFirstname  String?   @map("edx_user_firstname") @db.VarChar(200)
  edxUserLastname   String?   @map("edx_user_lastname") @db.VarChar(150)
  edxUserUsername   String?   @map("edx_user_username") @db.VarChar(50)
  edxUserStatus     Int?      @default(1) @map("edx_user_status")
  edxUserPhone      String?   @map("edx_user_phone") @db.VarChar(15)
  edxUserCredential String?   @map("edx_user_credential") @db.VarChar(15)
  edxUserCreatedAt  DateTime? @default(now()) @map("edx_user_created_at") @db.Timestamp(6)
  edxUserUpdatedAt  DateTime? @default(now()) @map("edx_user_updated_at") @db.Timestamp(6)
  edxUserDeletedAt  DateTime? @default(now()) @map("edx_user_deleted_at") @db.Timestamp(6)
  edxUserAvatar     String?   @map("edx_user_avatar")
  edxUserBirthdate  DateTime? @map("edx_user_birthdate") @db.Date

  // Professional attributes requested by user
  edxUserProvince         String?  @map("edx_user_province") @db.VarChar(100)
  edxUserCity             String?  @map("edx_user_city") @db.VarChar(100)
  edxUserZone             String?  @map("edx_user_zone") @db.VarChar(100)
  edxUserParish           String?  @map("edx_user_parish") @db.VarChar(100)
  edxUserAddress          String?  @map("edx_user_address") @db.VarChar(255)
  edxUserLatitude         String?  @map("edx_user_latitude") @db.VarChar(50)
  edxUserLongitude        String?  @map("edx_user_longitude") @db.VarChar(50)
  edxUserAbout            String?  @map("edx_user_about")
  edxUserRating           Float?   @default(0) @map("edx_user_rating")
  edxUserReviewCount      Int?     @default(0) @map("edx_user_review_count")
  edxUserCompletedJobs    Int?     @default(0) @map("edx_user_completed_jobs")
  edxUserViews            Int?     @default(0) @map("edx_user_views")
  edxUserRole             String?  @default("client") @map("edx_user_role") @db.VarChar(30)
  edxUserTipoTrabajo      String?  @map("edx_user_tipo_trabajo") @db.VarChar(100)
  edxUserSenescytTitle    String?  @map("edx_user_senescyt_title") @db.VarChar(255)
  edxUserSenescytCode     String?  @map("edx_user_senescyt_code") @db.VarChar(100)
  edxUserArtisanQualification Boolean? @map("edx_user_artisan_qualification")
  edxUserWorkshopName     String?  @map("edx_user_workshop_name") @db.VarChar(255)
  edxUserYearsExperience  Int?     @map("edx_user_years_experience")
  edxUserHasOwnTools      Boolean? @map("edx_user_has_own_tools")
  edxUserProfileComplete  Boolean? @default(false) @map("edx_user_profile_complete")
  edxUserProfessions      String[] @default([]) @map("edx_user_professions")
  edxUserActivities       Json?    @map("edx_user_activities")
  edxUserCustomProfession String?  @map("edx_user_custom_profession") @db.VarChar(200)
  edxUserAppliances       String[] @default([]) @map("edx_user_appliances")
  edxUserAdditionalPhone  String?  @map("edx_user_additional_phone") @db.VarChar(15)
  edxUserWebsite          String?  @map("edx_user_website") @db.VarChar(255)
  edxUserIsAvailable      Boolean? @default(true) @map("edx_user_is_available")
  edxUserCoverUrl         String?  @map("edx_user_cover_url")
  edxUserTrabajadorPagado Boolean? @default(false) @map("edx_user_trabajador_pagado")

  // Verification fields
  edxUserVerificationCompleted Boolean? @default(false) @map("edx_user_verification_completed")
  edxUserVerificationStatus    String?  @default("unverified") @map("edx_user_verification_status") @db.VarChar(30)
  edxUserVerificationAddress   String?  @map("edx_user_verification_address") @db.VarChar(255)
  edxUserCedulaNumber          String?  @map("edx_user_cedula_number") @db.VarChar(20)
  edxUserCedulaPath            String?  @map("edx_user_cedula_path")
  edxUserRucPath               String?  @map("edx_user_ruc_path")
  edxUserTituloPath            String?  @map("edx_user_titulo_path")
  edxUserGremioPath            String?  @map("edx_user_gremio_path")
  edxUserFrontalPath           String?  @map("edx_user_frontal_path")
  edxUserVideoPath             String?  @map("edx_user_video_path")
  edxUserVerificationSubmittedAt DateTime? @map("edx_user_verification_submitted_at") @db.Timestamp(6)

  devices            EdxDevice[]
  notifications      EdxNotification[]
  specialPermissions EdxRelationPermissionsUsers[]
  roles              EdxRelationRolesUsers[]
  sercopKeywords     EdxSercopKeyword[]
  subscription       EdxSubscription?
  payments           EdxPayment[]
  worker             EdxWorker?
  supportMessages    EdxSupportMessage[]
  supportTickets     EdxSupportTicket[]

  // Platform Relations
  posts           EdxPost[]
  reviewsReceived EdxReview[]       @relation("WorkerReviews")
  reviewsGiven    EdxReview[]       @relation("ClientReviews")
  postLikes       EdxPostLike[]
  postComments    EdxPostComment[]
  jobsAsWorker    EdxCompletedJob[] @relation("WorkerJobs")
  jobsAsClient    EdxCompletedJob[] @relation("ClientJobs")

  @@map("edx_users")
}

model EdxPost {
  edxPostId            String           @id @default(dbgenerated("gen_random_uuid()")) @map("edx_post_id") @db.Uuid
  edxUserId            String           @map("edx_user_id") @db.Uuid
  edxPostText          String?          @map("edx_post_text")
  edxPostImageUrl      String?          @map("edx_post_image_url")
  edxPostLikesCount    Int              @default(0) @map("edx_post_likes_count")
  edxPostCommentsCount Int              @default(0) @map("edx_post_comments_count")
  edxPostCreatedAt     DateTime         @default(now()) @map("edx_post_created_at") @db.Timestamp(6)
  user                 EdxUser          @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)
  likes                EdxPostLike[]
  comments             EdxPostComment[]

  @@map("edx_posts")
}

model EdxReview {
  edxReviewId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("edx_review_id") @db.Uuid
  edxWorkerId        String   @map("edx_worker_id") @db.Uuid
  edxClientId        String   @map("edx_client_id") @db.Uuid
  edxReviewRating    Float    @map("edx_review_rating")
  edxReviewComment   String?  @map("edx_review_comment")
  edxReviewCreatedAt DateTime @default(now()) @map("edx_review_created_at") @db.Timestamp(6)
  worker             EdxUser  @relation("WorkerReviews", fields: [edxWorkerId], references: [edxUserId], onDelete: Cascade)
  client             EdxUser  @relation("ClientReviews", fields: [edxClientId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_reviews")
}

model EdxPostLike {
  edxLikeId String  @id @default(dbgenerated("gen_random_uuid()")) @map("edx_like_id") @db.Uuid
  edxPostId String  @map("edx_post_id") @db.Uuid
  edxUserId String  @map("edx_user_id") @db.Uuid
  post      EdxPost @relation(fields: [edxPostId], references: [edxPostId], onDelete: Cascade)
  user      EdxUser @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@unique([edxPostId, edxUserId])
  @@map("edx_post_likes")
}

model EdxPostComment {
  edxCommentId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("edx_comment_id") @db.Uuid
  edxPostId           String   @map("edx_post_id") @db.Uuid
  edxUserId           String   @map("edx_user_id") @db.Uuid
  edxCommentText      String   @map("edx_comment_text")
  edxCommentCreatedAt DateTime @default(now()) @map("edx_comment_created_at") @db.Timestamp(6)
  post                EdxPost  @relation(fields: [edxPostId], references: [edxPostId], onDelete: Cascade)
  user                EdxUser  @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_post_comments")
}

model EdxCompletedJob {
  edxJobId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("edx_job_id") @db.Uuid
  edxWorkerId     String   @map("edx_worker_id") @db.Uuid
  edxClientId     String   @map("edx_client_id") @db.Uuid
  edxJobCreatedAt DateTime @default(now()) @map("edx_job_created_at") @db.Timestamp(6)
  worker          EdxUser  @relation("WorkerJobs", fields: [edxWorkerId], references: [edxUserId], onDelete: Cascade)
  client          EdxUser  @relation("ClientJobs", fields: [edxClientId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_completed_jobs")
}

model EdxDevice {
  edxDeviceId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("edx_device_id") @db.Uuid
  edxUserId     String?   @map("edx_user_id") @db.Uuid
  edxDevName    String?   @map("edx_name") @db.VarChar(100)
  edxDevOs      String?   @map("edx_so") @db.VarChar(50)
  edxDevLat     Float?    @map("edx_lat")
  edxDevLng     Float?    @map("edx_log")
  edxDevAddress String?   @map("edx_address") @db.VarChar(255)
  edxDevBrowser String?   @map("edx_browser") @db.VarChar(100)
  edxDevStatus  Int?      @default(1) @map("edx_device_status")
  edxLastUsed   DateTime? @default(now()) @map("edx_device_last_used") @db.Timestamp(6)
  edxDevIp      String?   @map("edx_device_ip") @db.VarChar(45)
  edxDevType    String?   @map("edx_device_type") @db.VarChar(20)
  user          EdxUser?  @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_devices")
}

model EdxRole {
  edxRoleId        String                      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_role_id") @db.Uuid
  edxRoleName      String                      @map("edx_role_name") @db.VarChar(100)
  edxRoleKey       String?                     @map("edx_role_key") @db.VarChar(30)
  edxRoleStatus    Int?                        @default(1) @map("edx_role_status")
  edxRoleCreatedAt DateTime?                   @default(now()) @map("edx_role_created_at") @db.Timestamp(6)
  edxRoleUpdatedAt DateTime?                   @default(now()) @map("edx_role_updated_at") @db.Timestamp(6)
  modules          EdxRelationRoleModule[]
  permissions      EdxRelationRolePermission[]
  sidebars         EdxRelationRolesSidebars[]
  users            EdxRelationRolesUsers[]

  @@map("edx_roles")
}

model EdxRelationRolesUsers {
  edxUserId String  @map("edx_user_id") @db.Uuid
  edxRoleId String  @map("edx_role_id") @db.Uuid
  edxStatus Int?    @default(1) @map("edx_rru_status")
  role      EdxRole @relation(fields: [edxRoleId], references: [edxRoleId], onDelete: Cascade)
  user      EdxUser @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@id([edxUserId, edxRoleId])
  @@map("edx_relation_roles_users")
}

model EdxSidebar {
  edxSidebarId       String                     @id @default(dbgenerated("gen_random_uuid()")) @map("edx_sidebar_id") @db.Uuid
  edxSidebarParentId String?                    @map("edx_sidebar_parent_id") @db.Uuid
  edxSidebarTitle    String                     @map("edx_sidebar_title") @db.VarChar(100)
  edxSidebarPath     String?                    @map("edx_sidebar_path") @db.VarChar(255)
  edxSidebarIcon     String?                    @map("edx_sidebar_icon") @db.VarChar(50)
  edxSidebarOrder    Int                        @default(0) @map("edx_sidebar_order")
  edxSidebarStatus   Int                        @default(1) @map("edx_sidebar_status")
  edxSidebarEnabled  Int                        @default(1) @map("edx_sidebar_enabled")
  roles              EdxRelationRolesSidebars[]
  parent             EdxSidebar?                @relation("SidebarToSidebar", fields: [edxSidebarParentId], references: [edxSidebarId])
  children           EdxSidebar[]               @relation("SidebarToSidebar")

  @@map("edx_sidebars")
}

model EdxRelationRolesSidebars {
  edxRoleId    String     @map("edx_role_id") @db.Uuid
  edxSidebarId String     @map("edx_sidebar_id") @db.Uuid
  edxStatus    Int?       @default(1) @map("edx_rs_status")
  role         EdxRole    @relation(fields: [edxRoleId], references: [edxRoleId], onDelete: Cascade)
  sidebar      EdxSidebar @relation(fields: [edxSidebarId], references: [edxSidebarId], onDelete: Cascade)

  @@id([edxRoleId, edxSidebarId])
  @@map("edx_relation_roles_sidebars")
}

model EdxModule {
  edxModId          String                  @id @default(dbgenerated("gen_random_uuid()")) @map("edx_mod_id") @db.Uuid
  edxModName        String                  @unique @map("edx_mod_name") @db.VarChar(20)
  edxModKey         String?                 @map("edx_mod_key") @db.VarChar(30)
  edxModDescription String?                 @map("edx_mod_description") @db.VarChar(50)
  edxModCreatedAt   DateTime?               @default(now()) @map("edx_mod_created_at") @db.Timestamp(6)
  edxModStatus      Int?                    @default(1) @map("edx_mod_status")
  edxModUpdatedAt   DateTime?               @default(now()) @map("edx_mod_updated_at") @db.Timestamp(6)
  roles             EdxRelationRoleModule[]

  @@map("edx_modules")
}

model EdxPermission {
  edxPermId              String                        @id @default(dbgenerated("gen_random_uuid()")) @map("edx_perm_id") @db.Uuid
  edxPermName            String                        @unique @map("edx_perm_name") @db.VarChar(20)
  edxPermKey             String?                       @map("edx_perm_key") @db.VarChar(20)
  edxPermDescription     String?                       @map("edx_perm_description") @db.VarChar(50)
  edxPermCreatedAt       DateTime?                     @default(now()) @map("edx_perm_created_at") @db.Timestamp(6)
  edxPermStatus          Int?                          @default(1) @map("edx_perm_status")
  edxPermUpdatedAt       DateTime?                     @default(now()) @map("edx_perm_updated_at") @db.Timestamp(6)
  userSpecialPermissions EdxRelationPermissionsUsers[]
  roles                  EdxRelationRolePermission[]

  @@map("edx_permissions")
}

model EdxRelationRoleModule {
  edxRoleId String    @map("edx_role_id") @db.Uuid
  edxModId  String    @map("edx_mod_id") @db.Uuid
  edxStatus BigInt    @default(1) @map("edx_rmp_status")
  module    EdxModule @relation(fields: [edxModId], references: [edxModId], onDelete: Cascade)
  role      EdxRole   @relation(fields: [edxRoleId], references: [edxRoleId], onDelete: Cascade)

  @@id([edxRoleId, edxModId])
  @@map("edx_relation_roles_modules")
}

model EdxRelationRolePermission {
  edxRoleId  String        @map("edx_role_id") @db.Uuid
  edxPermId  String        @map("edx_perm_id") @db.Uuid
  edxStatus  BigInt        @default(1) @map("edx_rmp_status")
  permission EdxPermission @relation(fields: [edxPermId], references: [edxPermId], onDelete: Cascade)
  role       EdxRole       @relation(fields: [edxRoleId], references: [edxRoleId], onDelete: Cascade)

  @@id([edxRoleId, edxPermId])
  @@map("edx_relation_roles_permissions")
}

model EdxRelationPermissionsUsers {
  edxPermId  String        @map("edx_perm_id") @db.Uuid
  edxUserId  String        @map("edx_user_id") @db.Uuid
  edxStatus  Int           @default(1) @map("edx_rpu_status")
  permission EdxPermission @relation(fields: [edxPermId], references: [edxPermId], onDelete: Cascade, map: "edx_permissions_users_edx_perm_id_fkey")
  user       EdxUser       @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@id([edxPermId, edxUserId], map: "edx_permissions_users_pkey")
  @@map("edx_relation_permissions_users")
}

model EdxSupportTicket {
  edxTicketId        String              @id @default(dbgenerated("gen_random_uuid()")) @map("edx_ticket_id") @db.Uuid
  edxUserId          String              @map("edx_user_id") @db.Uuid
  edxTicketTitle     String?             @map("edx_ticket_title") @db.VarChar(255)
  edxTicketStatus    Int                 @default(1) @map("edx_ticket_status")
  edxTicketCreatedAt DateTime            @default(now()) @map("edx_ticket_created_at") @db.Timestamp(6)
  edxTicketUpdatedAt DateTime            @default(now()) @map("edx_ticket_updated_at") @db.Timestamp(6)
  messages           EdxSupportMessage[]
  user               EdxUser             @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_support_tickets")
}

model EdxSupportMessage {
  edxMsgId        String           @id @default(dbgenerated("gen_random_uuid()")) @map("edx_message_id") @db.Uuid
  edxTicketId     String           @map("edx_ticket_id") @db.Uuid
  edxUserId       String           @map("edx_user_id") @db.Uuid
  edxMsgContent   String           @map("edx_message_content")
  edxIsSupport    Boolean          @default(false) @map("edx_is_support")
  edxMsgCreatedAt DateTime         @default(now()) @map("edx_message_created_at") @db.Timestamp(6)
  ticket          EdxSupportTicket @relation(fields: [edxTicketId], references: [edxTicketId], onDelete: Cascade)
  user            EdxUser          @relation(fields: [edxUserId], references: [edxUserId], onDelete: Cascade)

  @@map("edx_support_messages")
}

model EdxSetting {
  edxSettingId        String      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_setting_id") @db.Uuid
  edxSettingKey       String      @map("edx_setting_key") @db.VarChar(100)
  edxSettingValue     String      @map("edx_setting_value")
  edxSettingContext   String      @map("edx_setting_context") @db.VarChar(50)
  edxSettingStatus    Int         @default(1) @map("edx_setting_status")
  edxSettingCreatedAt DateTime?   @default(now()) @map("edx_setting_created_at") @db.Timestamp(6)
  edxSettingUpdatedAt DateTime?   @default(now()) @map("edx_setting_updated_at") @db.Timestamp(6)

  @@map("edx_settings")
}

model EdxTicket {
  ticId             String      @id @default(dbgenerated("gen_random_uuid()")) @map("tic_id") @db.Uuid
  conId             String      @map("con_id") @db.Uuid
  uniId             String?     @map("uni_id") @db.Uuid
  ticReportedBy     String      @map("tic_reported_by") @db.Uuid
  ticSubject        String      @map("tic_subject") @db.VarChar(200)
  ticPriority       EdxPriority @default(MEDIUM) @map("tic_priority")
  ticStatus         Int         @default(1) @map("tic_status")
  ticAssignedVendor String?     @map("tic_assigned_vendor") @db.Uuid
  ticSlaDeadline    DateTime?   @map("tic_sla_deadline") @db.Timestamptz(6)
  ticDeletedAt      DateTime?   @map("tic_deleted_at") @db.Timestamptz(6)
  ticCreatedAt      DateTime?   @default(now()) @map("tic_created_at") @db.Timestamptz(6)

  @@map("edx_tickets")
}

model EdxNotification {
  userId       String      @map("user_id") @db.Uuid
  ntfTitle     String      @map("ntf_title") @db.VarChar(200)
  ntfBody      String      @map("ntf_body")
  ntfType      String?     @map("ntf_type") @db.VarChar(50)
  ntfChannel   EdxChannel? @default(IN_APP) @map("ntf_channel")
  ntfStatus    Int?        @default(1) @map("ntf_status")
  ntfIsRead    Boolean?    @default(false) @map("ntf_is_read")
  ntfMetadata  Json?       @map("ntf_metadata")
  ntfCreatedAt DateTime?   @default(now()) @map("ntf_created_at") @db.Timestamptz(6)
  ntfId        String      @id @default(dbgenerated("gen_random_uuid()")) @map("edx_ntf_id") @db.Uuid
  user         EdxUser     @relation(fields: [userId], references: [edxUserId])

  @@map("edx_notifications")
}

model EdxSystemError {
  errId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("err_id") @db.Uuid
  errLevel      String?   @default("ERROR") @map("err_level") @db.VarChar(20)
  errModule     String    @map("err_module") @db.VarChar(50)
  errMessage    String    @map("err_message")
